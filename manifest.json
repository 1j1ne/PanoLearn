{
  "manifest_version": 3,
  "name": "PanoLearn \u2014 AI Study Notes for Canvas",
  "version": "1.9.1",
  "description": "Detects Panopto videos on Canvas LMS and generates AI-powered study notes using OpenAI.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.hosted.panopto.com/*",
    "https://*.panopto.com/*",
    "https://panolearn.yunchaei0701.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.hosted.panopto.com/*",
        "https://*.panopto.com/*"
      ],
      "js": [
        "sniffer.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.hosted.panopto.com/*",
        "https://*.panopto.com/*"
      ],
      "js": [
        "transcript.js",
        "capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.hosted.panopto.com/*",
        "https://*.panopto.com/*"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "panel-ui.js",
        "accuracy.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "privacy.html"
      ],
      "matches": [
        "https://*.instructure.com/*",
        "https://*.panopto.com/*"
      ]
    }
  ]
}
